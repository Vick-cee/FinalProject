{
  "expo": {
    "name": "KASU Gate Scanner",
    "slug": "kasu-gate-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./kasu-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#780016"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow KASU Gate Scanner to access your camera to scan driver vehicle pass QR codes."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "KASU Gate Scanner requires camera access to scan driver vehicle pass QR codes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./kasu-logo.png",
        "backgroundColor": "#780016"
      },
      "permissions": [
        "CAMERA"
      ]
    }
  }
}
